# .env 로 복사 후 값 채우기: cp .env.example .env
# 원격 LiteLLM 노드 (없으면 비워둠 — 로컬 단일 노드로 동작)
RQA_LITELLM_URL=https://your-litellm-host/v1
RQA_LITELLM_KEY=sk-your-key-here
RQA_LITELLM_MODEL=

# GitHub OAuth Device Flow (private repo 로그인)
# github.com/settings/developers → New OAuth App → Enable Device Flow
RQA_GH_CLIENT_ID=your-client-id

# 선택: 로컬 모델 오버라이드
# RQA_MODEL=gemma4:26b
# RQA_EMBED=bge-m3:latest
# RQA_MAX_QA_CHUNKS=24
